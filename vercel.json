{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build && npx esbuild api/index.ts --platform=node --packages=external --bundle --format=esm --outfile=api/index.js --alias:@shared=./shared",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/trpc/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/scheduled/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|auth|storage|assets|_next).*)",
      "destination": "/index.html"
    }
  ]
}
